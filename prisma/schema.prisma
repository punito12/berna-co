// Berna&co data model. See docs/ROADMAP "Modelo de datos".
// Enum-like fields are stored as String for portability and validated in
// application code (lib/). Allowed values are documented inline.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          String  @id @default(cuid())
  name        String
  description String // short description, shown on the catalog cards
  longDescription String @default("") // full description, shown on the detail page (universal for the whole cut)

  // JSON map of per-empanado description, e.g.
  // {"KETO":"Empanado keto sin harinas...","INTEGRAL":"Con pan integral..."}.
  // Shown on the detail page below the universal description; swaps when the
  // customer picks a different empanado. Empty entries are simply not shown.
  empanadoDescriptions String @default("{}")
  slug        String  @unique
  weightGrams Int
  category    String // CARNE | POLLO | CERDO | VEGANO
  price       Int // PRECIO WEB: precio online (tienda/Mercado Pago/tarjeta). Default/fallback en pesos.
  imageUrl    String // cover photo, shown on the catalog cards

  // JSON map of WEB price per empanado, e.g. {"TRADITIONAL":8500,"KETO":9000}.
  // Falls back to `price` when a breadcrumb has no specific entry.
  prices String @default("{}")

  // PRECIO EFECTIVO/TRANSFERENCIA: precio base (real) usado en efectivo,
  // transferencia, ventas manuales y remitos. 0/"{}" = no cargado → se usa el
  // precio web como fallback (así nada cambia hasta que el admin lo cargue).
  priceCashTransfer Int @default(0)
  // JSON map del precio efectivo/transferencia por empanado (espeja `prices`).
  pricesCashTransfer String @default("{}")
  available   Boolean @default(true)
  isNew       Boolean @default(false)
  stock       Int     @default(0) // legacy/fallback total; per-empanado lives in `stocks`

  // JSON map of stock per empanado, e.g. {"TRADITIONAL":10,"KETO":5}.
  // When set, it overrides `stock`. Each variant is sold/decremented on its own.
  stocks String @default("{}")

  // JSON array of photo paths for the product detail gallery, e.g.
  // ["/images/productos/peceto-pastura.jpg","/images/productos/peceto-pastura-2.jpg"]
  images String @default("[]")

  // JSON array of allowed breadcrumb types, e.g. ["TRADITIONAL","INTEGRAL","KETO"]
  availableBreadcrumbs String

  // JSON array of breadcrumb types temporarily turned OFF by the admin, e.g.
  // ["KETO"]. They keep their price/stock/photos but aren't sold until re-enabled.
  disabledBreadcrumbs String @default("[]")

  // Current cost per kg (pesos), loaded by the admin. Used for margin/profit.
  costPerKg Int @default(0)

  // Per-empanado cost (pesos per kg), JSON like `prices`, e.g.
  // {"TRADITIONAL":16048,"KETO":18048}. Source of truth for Costos y Precios.
  costs String @default("{}")

  // --- Automatic per-product promotions (web store) ---
  // Legacy product-wide promo (kept for back-compat / fallback).
  promoPercent Int @default(0)
  promoType String @default("")
  // Per-empanado promos (override the product-wide ones when present):
  // promoPercents JSON {empanado: percent}, e.g. {"KETO":20}
  // promoTypes   JSON {empanado: "2x1"|"3x2"}, e.g. {"KETO":"2x1"}
  promoPercents String @default("{}")
  promoTypes    String @default("{}")

  orderItems     OrderItem[]
  saleItems      SaleItem[]
  stockMovements StockMovement[]
  costSheets     CostSheet[]
  costHistory    CostHistory[]
  priceHistory   PriceHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A single change to a product's per-empanado stock, with its cause. Quantity
// is signed: positive adds stock (producción, ajuste +), negative removes it
// (venta, merma, ajuste −). The reference links to the sale/order/purchase that
// originated it (when applicable), so the history is auditable.
model StockMovement {
  id   String   @id @default(cuid())
  date DateTime @default(now())

  productId      String
  product        Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  breadcrumbType String // TRADITIONAL | INTEGRAL | KETO

  quantity Int // signed units (+ adds, − removes)
  type     String // PRODUCTION | SALE | ADJUSTMENT | WASTE | PURCHASE

  // What originated the movement (for the audit trail + linking back).
  referenceType String? // ORDER | MANUAL_SALE | PURCHASE | MANUAL
  referenceId   String?

  notes String?

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([date])
  @@index([type])
}

model Order {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  status String @default("PENDING") // PENDING | CONFIRMED | READY | DELIVERED | CANCELLED

  customerName  String
  customerPhone String
  customerEmail String? // optional

  deliveryType String // DELIVERY | PICKUP
  address      String? // only for DELIVERY
  lat          Float? // geocoded coordinates of the address (DELIVERY)
  lng          Float?

  scheduledDate DateTime
  scheduledSlot String // e.g. "10:00–12:00"

  paymentMethod String // MERCADOPAGO | CASH
  shippingCost  Int     @default(0) // delivery fee included in `total`
  discountCode  String? // code applied (if any)
  discountAmount Int    @default(0) // total discount in pesos (promos + code)
  total         Int
  mpPaymentId   String? // null when paying cash
  notes         String?

  // Web orders are linked to a Customer (auto-created/reused by name+phone).
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // Cuenta corriente: PAID = saldado, PARTIAL = pago parcial, PENDING = a deber.
  // Web orders start PENDING; MP approval or admin payment registration marks paid.
  paymentStatus String    @default("PENDING") // PAID | PARTIAL | PENDING
  dueDate       DateTime? // vencimiento (cuenta corriente)

  items    OrderItem[]
  payments Payment[]
}

model OrderItem {
  id          String @id @default(cuid())
  orderId     String
  productId   String
  quantity    Int
  priceAtTime Int

  breadcrumbType String // TRADITIONAL | INTEGRAL | KETO

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model DeliverySlot {
  id        String  @id @default(cuid())
  label     String // e.g. "10:00–12:00"
  available Boolean @default(true)
  scheduleType String @default("DELIVERY") // DELIVERY | PICKUP

  @@index([scheduleType])
}

model AvailableDeliveryDay {
  id        String  @id @default(cuid())
  dayOfWeek Int     // 0=Sun ... 6=Sat
  available Boolean @default(true)
  scheduleType String @default("DELIVERY") // DELIVERY | PICKUP

  @@unique([scheduleType, dayOfWeek])
  @@index([scheduleType])
}

// Newsletter subscribers captured from the footer form.
model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// A delivery zone is a polygon on the map plus the weekdays we deliver inside
// it. Coverage is decided by point-in-polygon on the customer's coordinates.
model Zone {
  id   String @id @default(cuid())
  name String // e.g. "San Isidro", "Zona Norte"
  // The coverage area as a GeoJSON geometry (Polygon), stored as a JSON string.
  // null/empty until the admin draws it on the map.
  polygon String?
  // JSON array of weekday numbers we deliver here, e.g. [1,3,5] (0=Sun..6=Sat).
  daysOfWeek String @default("[]")
  active    Boolean @default(true)

  // Delivery pricing for this zone (in pesos).
  shippingCost Int @default(0) // flat delivery fee
  // Free delivery when the products subtotal reaches this amount; 0 = never free.
  freeShippingFrom Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---- Admin management (clients, manual sales, profitability) ----

// A wholesale/retail customer for manual sales. type drives the default
// discount, which can still be overridden per sale.
// A barrio (closed neighborhood). Created by the admin, then assigned to
// customers from a dropdown.
model Barrio {
  id        String     @id @default(cuid())
  name      String     @unique
  customers Customer[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Customer {
  id              String  @id @default(cuid())
  name            String
  type            String  @default("MINORISTA") // MINORISTA | MAYORISTA | KIOSCO
  defaultDiscount Int     @default(0) // percent (0..100)
  phone           String?
  email           String?
  notes           String?
  lot             String? // lote within the barrio
  // Source: WEB (auto-created from a web order) or MANUAL (loaded by the admin).
  source          String  @default("MANUAL")

  barrioId String?
  barrio   Barrio? @relation(fields: [barrioId], references: [id], onDelete: SetNull)

  sales        ManualSale[]
  orders       Order[]
  remitos      Remito[]
  presupuestos Presupuesto[]
  prospectStores ProspectStore[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A sale entered by hand (not from the web): WhatsApp, wholesale, kiosk, etc.
// Totals are stored in pesos and recomputed server-side from the items.
model ManualSale {
  id         String   @id @default(cuid())
  soldAt     DateTime // sale date (admin chooses it)
  channel    String // WEB | WHATSAPP | MAYORISTA | KIOSCO
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  // Free-text customer name when not picking one from the list.
  customerName String?
  // Neighborhood snapshot (from the chosen customer) for billing breakdown.
  neighborhood String?

  discountPct Int @default(0) // discount applied to this sale (percent)
  // Stored money fields (pesos): gross = sum of item subtotals (no discount),
  // discountAmount = gross - net, net = what was charged.
  gross          Int
  discountAmount Int
  net            Int

  notes String?

  // Medio de pago de la venta manual (lo elige el admin al cargarla).
  paymentMethod String @default("EFECTIVO") // EFECTIVO | TRANSFERENCIA | MERCADO_PAGO | OTRO
  // Cuenta corriente: PAID por defecto; los mayoristas nacen PENDING a 30 días.
  paymentStatus String    @default("PAID") // PAID | PARTIAL | PENDING
  dueDate       DateTime? // vencimiento (cuenta corriente)

  // Estado logístico de la venta, separado del pago. Al cancelar se reintegra
  // el stock descontado al cargarla.
  deliveryStatus String @default("PENDING") // PENDING | DELIVERED | CANCELLED

  // ¿Esta venta descontó stock al cargarse? true = sí (comportamiento histórico:
  // descuenta al crear y reintegra al cancelar/editar). false = NO mueve stock
  // (p. ej. mercadería ya descontada antes; solo se factura/registra la venta).
  // Cancelar/editar respetan esta bandera: si no descontó, tampoco reintegra.
  stockDiscounted Boolean @default(true)

  items    SaleItem[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A payment received against a sale or order (cuenta corriente). Each payment
// creates a CashMovement of type INCOME. A sale/order may have many payments
// (partial). paymentStatus on the sale is recomputed from the sum of payments.
model Payment {
  id     String   @id @default(cuid())
  date   DateTime @default(now())
  amount Int // pesos, positive
  method String // EFECTIVO | MERCADO_PAGO | TRANSFERENCIA
  notes  String?

  // Linked to at most one of these.
  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  saleId  String?
  sale    ManualSale? @relation(fields: [saleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([saleId])
}

// One product line within a manual sale. Quantities are in units.
model SaleItem {
  id        String @id @default(cuid())
  saleId    String
  sale      ManualSale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  // Snapshot of the product name (so it survives product deletion / free items).
  productName String
  // Chosen empanado (breadcrumb) — used to discount the right stock bucket.
  breadcrumbType String?

  quantity     Int // units sold
  unitPrice    Int // price per unit at sale time (pesos)
  lineSubtotal Int // quantity * unitPrice, before the sale discount (pesos)
}

// Cash box (Caja) movement: an income or expense, manual or auto-generated from
// a web order / manual sale. MP incomes carry the real accrual date so the box
// can separate money available today from money pending release.
model CashMovement {
  id   String   @id @default(cuid())
  date DateTime // when the movement happened (income earned / expense paid)

  type   String // INCOME | EXPENSE
  amount Int // pesos, always positive; `type` gives the sign

  description String
  category    String // expense categories or income label (see lib/cash.ts)

  // INCOME source channel. EXPENSE rows leave this empty.
  source String @default("") // EFECTIVO | MERCADO_PAGO | TRANSFERENCIA

  // AVAILABLE = counted in today's balance. PENDING = money not released yet
  // (MP), counted in "a acreditar" until `accrualDate` passes.
  status      String    @default("AVAILABLE")
  accrualDate DateTime? // real money_release_date for MP; null = immediate

  // Links back to the origin so movements are idempotent (one per payment/order).
  paymentId  String? @unique // MP payment id
  orderId    String? // web order that generated this movement
  saleId     String? // manual sale that generated this movement
  purchaseId String? // supplier purchase that generated this expense

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([status, accrualDate])
}

// A supplier (proveedor) the business buys from.
model Supplier {
  id              String  @id @default(cuid())
  name            String
  type            String  @default("OTROS") // CARNE | HUEVOS | PACKAGING | SERVICIOS | OTROS
  contact         String? // phone / email / contact name
  notes           String?
  defaultDueDays  Int     @default(30) // credit term used by default for purchases

  purchases Purchase[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A purchase (compra / orden de compra) made to a supplier. Totals in pesos.
model Purchase {
  id         String   @id @default(cuid())
  date       DateTime // purchase date (admin chooses it)
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  // gross = Σ item subtotals; discountAmount; total = gross − discountAmount.
  gross          Int
  discountAmount Int @default(0)
  total          Int

  // Cuenta por pagar: PAID por defecto si se carga ya pagada; PENDING si queda
  // a deber (con vencimiento). Recalculado desde la suma de pagos.
  paymentStatus String    @default("PENDING") // PAID | PARTIAL | PENDING
  dueDate       DateTime?

  notes String?

  items    PurchaseItem[]
  payments SupplierPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId])
}

// One line within a purchase. Quantities are free-form (kg, units, etc.).
model PurchaseItem {
  id         String   @id @default(cuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  description String
  quantity    Float // amount bought
  unit        String  @default("unidades") // kg | unidades | cajas | ...
  unitPrice   Int // pesos per unit
  subtotal    Int // quantity * unitPrice (pesos)
}

// A payment made to a supplier against a purchase. Each one creates a
// CashMovement of type EXPENSE. A purchase may have many (partial) payments.
model SupplierPayment {
  id     String   @id @default(cuid())
  date   DateTime @default(now())
  amount Int // pesos, positive
  method String // EFECTIVO | MERCADO_PAGO | TRANSFERENCIA
  notes  String?

  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([purchaseId])
}

// A discount code the customer types at checkout. Percent OR fixed amount.
model DiscountCode {
  id        String  @id @default(cuid())
  code      String  @unique // stored uppercase, e.g. "BERNA10"
  kind      String // PERCENT | FIXED
  value     Int // percent (0..100) when PERCENT; pesos when FIXED
  active    Boolean @default(true)
  expiresAt DateTime? // optional validity end
  maxUses   Int       @default(0) // 0 = unlimited
  usedCount Int       @default(0)
  minTotal  Int       @default(0) // minimum products subtotal (pesos) to apply

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---- Costos y Precios (Catálogo) ----

// Global pricing parameters. Singleton: exactly one row (id = "singleton").
model PricingConfig {
  id                       String @id @default("singleton")
  sueldoPercent            Int    @default(15)
  utilidadPercent          Int    @default(50)
  descuentoMayoristaPercent Int   @default(25)
  descuentoKioscoPercent   Int    @default(30)

  updatedAt DateTime @updatedAt
}

// A cost sheet (planilla de costos) for one product+empanado — a flat replica
// of the user's Excel. Only CANTIDAD and PRECIO UNIT fields are stored; every
// total (subtotal, costo1xKg, costo2xKg, sueldo, utilidades, precioFinal) is
// computed in lib/cost-sheets.ts. Many sheets can exist per product+empanado.
model CostSheet {
  id             String   @id @default(cuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  breadcrumbType String // TRADITIONAL | INTEGRAL | KETO
  fecha          DateTime @default(now())
  notas          String?

  // Materia prima
  compraKg         Float @default(0)
  compraPrecioUnit Int   @default(0) // price per kg
  limpioKg         Float @default(0) // net kg after cleaning (desperdicio = compra − limpio)

  // Otros ítems fijos (todos opcionales)
  huevosCantidad      Int   @default(0)
  huevosPrecioUnit    Int   @default(0)
  integralKg          Float @default(0)
  integralPrecioUnit  Int   @default(0)
  tradicionalKg       Float @default(0)
  tradicionalPrecioUnit Int @default(0)
  marinadaCantidad    Float @default(0)
  marinadaPrecioUnit  Int   @default(0)

  // Producto final
  prodFinalKg       Float @default(0)
  bolsaCantidad     Int   @default(0)
  bolsaPrecioUnit   Int   @default(0)
  etiquetaCantidad  Int   @default(0)
  etiquetaPrecioUnit Int  @default(0)

  // Parámetros (snapshot al guardar)
  sueldoPercent     Int @default(15)
  utilidadesPercent Int @default(50)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, breadcrumbType])
}

// A competitor's price for a (free-text) product, per kg.
model CompetitorPrice {
  id         String  @id @default(cuid())
  productName String // free text (may match one of our products)
  competitor String
  pricePerKg Int

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// Cost change log — one row each time a product+empanado cost changes.
model CostHistory {
  id             String  @id @default(cuid())
  productId      String
  product        Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  breadcrumbType String
  costPerKg      Int
  changedAt      DateTime @default(now())

  @@index([productId, breadcrumbType])
}

// Price change log — one row each time a product+empanado channel price changes.
model PriceHistory {
  id             String  @id @default(cuid())
  productId      String
  product        Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  breadcrumbType String
  channel        String // PUBLICO | MAYORISTA | KIOSCO
  price          Int
  changedAt      DateTime @default(now())

  @@index([productId, breadcrumbType])
}

// A volume discount tier: buying at least `minKg` total grants `discountPercent`
// off the products subtotal. The highest active tier the customer reaches wins.
model QuantityDiscount {
  id              String  @id @default(cuid())
  minKg           Float
  discountPercent Int
  active          Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Payment-method config (singleton). Per-method discounts shown in the store +
// transfer instructions (alias/CBU/WhatsApp) for the transferencia flow.
model PaymentMethodConfig {
  id                       String @id @default("singleton")
  efectivoDiscountPercent  Int    @default(0)
  transferenciaDiscountPercent Int @default(0)
  aliasMercadoPago         String @default("")
  cbu                      String @default("")
  whatsappNumber           String @default("")

  updatedAt DateTime @updatedAt
}

// Digital remitos created from the admin. They are independent from orders,
// stock, caja and payments: saving/printing a remito does not move inventory or
// money.
model Remito {
  id        String   @id @default(cuid())
  number    Int      @unique
  date      DateTime
  // Nombre del cliente (snapshot visible, histórico). Se mantiene siempre.
  customerName String
  // Cliente registrado vinculado (opcional). Los remitos nuevos eligen un cliente
  // del registro; los viejos quedan con customerName y se pueden vincular después.
  // Aditivo y nullable: no reescribe remitos existentes.
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  subtotal       Int @default(0)
  discountPercent Float @default(0)
  discountAmount  Int @default(0)
  total          Int @default(0)

  paymentMethod String @default("")
  note          String @default("")

  receivedSignature String @default("")
  receivedClarification String @default("")
  receivedDate DateTime?

  archived Boolean @default(false)
  items    RemitoItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([archived])
}

model RemitoItem {
  id        String @id @default(cuid())
  remitoId  String
  remito    Remito @relation(fields: [remitoId], references: [id], onDelete: Cascade)

  quantity    Float
  unit        String @default("kg") // kg | paq.
  description String
  unitPrice   Int
  total       Int

  order Int @default(0)

  @@index([remitoId])
}

// ---- CMS (Editor del sitio) ----

// Singleton: theme colors + typography. One row (id = "singleton").
model SiteContent {
  id          String  @id @default("singleton")
  // JSON of semantic color tokens (hex), e.g. {"ink":"#0A0A0A","cream":"#F5F0EB",
  // "line":"#E8E3DC","muted":"#6B6560","accent":"#c0392b"}. *Draft mirrors it.
  themeColors      String @default("{}")
  themeColorsDraft String @default("{}")
  // JSON of typography, e.g. {"headingFont":"Archivo","bodyFont":"Archivo",
  // "headingWeight":"900"}.
  typography       String @default("{}")
  typographyDraft  String @default("{}")
  // Logo image (branding).
  logoUrl      String @default("")
  logoUrlDraft String @default("")

  publishedAt DateTime?
  updatedAt   DateTime @updatedAt
}

// One editable text string of the site. `value` is published, `valueDraft` is
// being edited.
model SiteText {
  id         String  @id @default(cuid())
  key        String  @unique // e.g. "home.hero.title"
  value      String  @default("")
  valueDraft String  @default("")
  style      String  @default("{}") // JSON text style published by the CMS
  styleDraft String  @default("{}") // JSON text style draft edited by admin
  maxLength  Int     @default(200)
  category   String  @default("home") // home | catalogo | checkout | footer | legal
  updatedAt  DateTime @updatedAt
}

// One editable image of the site.
model SiteImage {
  id       String  @id @default(cuid())
  key      String  @unique // e.g. "home.hero.background"
  url      String  @default("")
  urlDraft String  @default("")
  category String  @default("home")
  updatedAt DateTime @updatedAt
}

// A page section: lets the admin reorder + show/hide (and edit its config).
model SiteSection {
  id          String  @id @default(cuid())
  key         String  @unique // e.g. "home.hero"
  page        String  @default("home") // home | ...
  order       Int     @default(0)
  orderDraft  Int     @default(0)
  visible     Boolean @default(true)
  visibleDraft Boolean @default(true)
  type        String // hero | products_grid | features | testimonials | faq | newsletter | custom
  config      String  @default("{}") // JSON
  configDraft String  @default("{}")
  updatedAt   DateTime @updatedAt
}

// A published snapshot of the whole site content, for revert/backup.
model SiteVersion {
  id          String   @id @default(cuid())
  snapshot    String // JSON: SiteContent + texts + images + sections (published)
  publishedAt DateTime @default(now())
  publishedBy String   @default("admin")
}

// ---- Analytics (embudo del ecommerce público) ----

// Un evento de analytics anónimo: page views + eventos de negocio del funnel.
// SIN datos personales (nombre/teléfono/email/dirección exacta nunca se guardan).
// La identidad es anónima (anonymousId persistente + sessionId por sesión). Los
// nombres de evento se validan en lib/analytics.ts contra ANALYTICS_EVENTS.
model AnalyticsEvent {
  id          String   @id @default(cuid())
  eventName   String // page_view | product_view | add_to_cart | order_created | ... (ver lib/analytics)
  sessionId   String // id de sesión (cookie, expira con la sesión)
  anonymousId String // id anónimo persistente (cookie 1 año)

  path     String? // ruta de la página (sin querystring sensible)
  referrer String?

  // Campaña (UTM) capturada al entrar y persistida por la sesión.
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  utmTerm     String?

  // Contexto de producto / funnel (todo opcional según el evento).
  productId      String?
  productName    String?
  variantName    String? // empanado elegido
  quantity       Int?
  value          Int? // monto en pesos enteros (ej. total del pedido)
  paymentMethod  String? // EFECTIVO | TRANSFERENCIA | MERCADOPAGO
  deliveryMethod String? // DELIVERY | PICKUP
  locality       String? // localidad/barrio GENERAL (nunca dirección exacta)
  orderId        String? // para order_created (dedupe por este id)

  // Datos extra flexibles (JSON stringificado), para crecer sin migrar.
  metadata String?

  createdAt DateTime @default(now())

  @@index([eventName])
  @@index([createdAt])
  @@index([sessionId])
  @@index([anonymousId])
  @@index([orderId])
  @@index([productId])
}

// ---- Presupuestos (documentos comerciales / cotizaciones) ----

// Un presupuesto es SOLO un documento comercial (cotización). NO es remito, ni
// pedido, ni venta: no toca stock, caja, cuentas por cobrar ni reportes. El
// primer tipo ("LISTA_MAYORISTA") es una lista personalizada de precios: por
// cada producto muestra P. Lista (precio de remito) y P. Mayor. (P. Lista −%).
model Presupuesto {
  id     String @id @default(cuid())
  number Int    @unique
  // PRICE_LIST = lista de precios mayorista (Descripción/P.Lista/P.Mayor, sin
  // cantidades ni total). QUOTATION = cotización tipo remito (cantidad × precio
  // = subtotal, con total). Ambos son SOLO documentos, sin efectos operativos.
  type   String @default("PRICE_LIST") // PRICE_LIST | QUOTATION

  // Cliente registrado (opcional) o potencial cliente por nombre libre.
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName String

  date       DateTime
  validUntil DateTime? // validez del presupuesto (opcional)

  // Total del documento (solo QUOTATION; PRICE_LIST queda en 0). Snapshot para
  // mostrarlo en la lista sin recalcular.
  total Int @default(0)

  // Borrador | Enviado | Aceptado | Rechazado. Solo informativo: NO dispara
  // ningún efecto de negocio (stock/caja/ventas).
  status String @default("BORRADOR") // BORRADOR | ENVIADO | ACEPTADO | RECHAZADO

  // Descuento mayorista por defecto 25% (P. Mayor. = P. Lista * (1 - %/100)).
  discountPercent Float @default(25)

  notesInternal String @default("") // nota interna, NO se imprime

  items PresupuestoItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([status])
  @@index([customerId])
}

// Una línea del presupuesto. Snapshots como remito/orden: el presupuesto viejo
// no cambia si el precio del producto cambia después.
model PresupuestoItem {
  id            String      @id @default(cuid())
  presupuestoId String
  presupuesto   Presupuesto @relation(fields: [presupuestoId], references: [id], onDelete: Cascade)

  // Producto/empanado de origen (opcional: permite ítem de texto libre).
  productId      String?
  breadcrumbType String? // empanado elegido

  // Snapshots para histórico estable.
  productName    String // "Peceto de Pastura"
  variantName    String @default("") // empanado, ej "Integral"

  // --- PRICE_LIST: lista de precios mayorista (sin cantidad, sin total) ---
  listPrice      Int @default(0) // P. Lista (precio de remito) en pesos
  wholesalePrice Int @default(0) // P. Mayor. = listPrice * (1 - discount/100)

  // --- QUOTATION: cotización tipo remito (cantidad × precio = subtotal) ---
  quantity  Float @default(0) // cantidad cotizada
  unitPrice Int   @default(0) // precio unitario (misma lógica que remito)
  subtotal  Int   @default(0) // quantity * unitPrice

  sortOrder Int @default(0)

  createdAt DateTime @default(now())

  @@index([presupuestoId])
}

// ---- Puntos potenciales de venta (descubrimiento comercial) ----

// Área comercial editable. Es independiente de Zone (reparto): una misma
// localidad puede tener polígonos comerciales y logísticos diferentes.
model ProspectZone {
  id      String @id @default(cuid())
  name    String
  kind    String @default("CUSTOM") // NEIGHBORHOOD | LOCALITY | GATED_COMMUNITY | COMMERCIAL_CENTER | CUSTOM
  tier    String @default("C") // A | B | C | EXCLUDED
  polygon String // GeoJSON Polygon, JSON stringificado

  active            Boolean @default(true)
  scanEnabled       Boolean @default(true)
  gridSpacingMeters Int     @default(700)
  searchRadiusMeters Int    @default(500)
  defaultRequestLimit Int   @default(250)
  notes             String  @default("")

  queries   ProspectZoneQuery[]
  scans     ProspectScan[]
  prospects ProspectStore[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tier])
  @@index([active, scanEnabled])
}

// Catálogo editable de búsquedas. TYPE usa Nearby Search; TEXT usa Text Search.
model ProspectSearchQuery {
  id             String  @id @default(cuid())
  label          String
  provider       String  @default("GOOGLE") // GOOGLE | GREEN_LIFE
  mode           String  @default("TEXT") // TYPE | TEXT | DIRECTORY
  value          String
  placeTypes     String  @default("[]") // JSON array de Google Place types
  categoryFamily String  @default("GENERAL")
  active         Boolean @default(true)
  sortOrder      Int     @default(0)

  zones ProspectZoneQuery[]
  cells ProspectScanCell[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([provider, active])
  @@index([sortOrder])
}

model ProspectZoneQuery {
  zoneId  String
  zone    ProspectZone        @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  queryId String
  query   ProspectSearchQuery @relation(fields: [queryId], references: [id], onDelete: Cascade)

  @@id([zoneId, queryId])
  @@index([queryId])
}

// Configuración determinística editable (tiers, categorías, palabras y
// exclusiones). Singleton: id = "singleton"; config siempre se parsea con fallback.
model ProspectScoringConfig {
  id     String @id @default("singleton")
  config String @default("{}")

  updatedAt DateTime @updatedAt
}

// Un scan se crea rápido desde el admin y luego lo consume el worker/cron.
model ProspectScan {
  id     String       @id @default(cuid())
  zoneId String
  zone   ProspectZone @relation(fields: [zoneId], references: [id], onDelete: Restrict)

  status String @default("PENDING") // PENDING | RUNNING | PAUSED | COMPLETED | PARTIAL_FAILED | LIMIT_REACHED | CANCELLED
  querySnapshot String @default("[]") // JSON de las consultas seleccionadas
  includeActivityData Boolean @default(false) // Legacy: discovery nunca solicita rating/reseñas.
  requestLimit Int
  resultLimitPerRequest Int @default(20)
  estimatedRequests Int @default(0)
  estimatedDetailRequests Int @default(0)
  estimatedCostUsdCents Int @default(0)
  estimatedMaxCostUsdCents Int @default(0)

  requestCount       Int @default(0)
  detailRequestCount Int @default(0)
  successfulRequests Int @default(0)
  failedRequests     Int @default(0)
  newProspects       Int @default(0)
  updatedProspects   Int @default(0)
  duplicatesDetected Int @default(0)
  errorLog           String @default("[]") // JSON array de errores estructurados

  lockToken     String?
  lockExpiresAt DateTime?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cells             ProspectScanCell[]
  discoveredStores  ProspectStore[]
  sources            ProspectSource[]

  @@index([status, createdAt])
  @@index([zoneId, createdAt])
  @@index([lockExpiresAt])
}

// Unidad idempotente: un punto de grilla + una consulta. La clave se deriva de
// scan/punto/query, por lo que reintentar nunca duplica una celda.
model ProspectScanCell {
  id       String       @id @default(cuid())
  scanId   String
  scan     ProspectScan @relation(fields: [scanId], references: [id], onDelete: Cascade)
  queryId  String?
  query    ProspectSearchQuery? @relation(fields: [queryId], references: [id], onDelete: SetNull)

  key           String
  pointIndex    Int
  latitude      Float
  longitude     Float
  radiusMeters  Int
  querySnapshot String
  status        String @default("PENDING") // PENDING | RUNNING | COMPLETED | FAILED | SKIPPED
  attempts      Int    @default(0)
  requestCount  Int    @default(0)
  detailRequestCount Int @default(0)
  resultCount   Int    @default(0)
  error         String?
  nextAttemptAt DateTime?
  startedAt     DateTime?
  completedAt   DateTime?

  sources ProspectSource[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scanId, key])
  @@index([scanId, status, pointIndex])
  @@index([nextAttemptAt])
}

// Prospecto descubierto. No contiene contactos ni datos personales y no se
// convierte en Customer hasta una acción explícita del operador.
model ProspectStore {
  id                String @id @default(cuid())
  name              String
  normalizedName    String
  address           String
  normalizedAddress String
  neighborhood      String?
  locality          String?
  province          String?
  country           String @default("Argentina")
  latitude          Float
  longitude         Float

  zoneId String?
  zone   ProspectZone? @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  discoveryScanId String?
  discoveryScan   ProspectScan? @relation(fields: [discoveryScanId], references: [id], onDelete: SetNull)

  googlePlaceId  String? @unique
  googleMapsUrl  String?
  categoryKey    String
  rawCategories  String @default("[]")
  detectedKeywords String @default("[]")
  operatingStatus String?
  permanentlyClosed Boolean @default(false)
  rating          Float?
  reviewCount     Int?

  score            Int    @default(0)
  scoreBreakdown   String @default("[]")
  scoreExplanation String @default("")
  isExcluded       Boolean @default(false)
  ambiguousClassification Boolean @default(false)
  classificationSource String @default("RULES") // RULES | MANUAL | AI
  classificationConfidence Float @default(1)

  status String @default("NEW") // NEW | PENDING_REVIEW | INTERESTING | HIGH_PRIORITY | VISITED | EXISTING_CLIENT | DISCARDED | DUPLICATE | CLOSED
  notes  String @default("")
  manualCategory String?
  manualScore Int?
  manualScoreReason String?

  existingClientCandidateId String?
  linkedCustomerId String?
  linkedCustomer Customer? @relation(fields: [linkedCustomerId], references: [id], onDelete: SetNull)

  firstDiscoveredAt DateTime @default(now())
  lastVerifiedAt    DateTime @default(now())
  reviewedAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  sources       ProspectSource[]
  statusHistory ProspectStatusHistory[]
  duplicateAsFirst  ProspectDuplicateCandidate[] @relation("ProspectDuplicateFirst")
  duplicateAsSecond ProspectDuplicateCandidate[] @relation("ProspectDuplicateSecond")

  @@index([score])
  @@index([status])
  @@index([categoryKey])
  @@index([province, locality])
  @@index([zoneId])
  @@index([firstDiscoveredAt])
  @@index([normalizedName, normalizedAddress])
  @@index([latitude, longitude])
  @@index([existingClientCandidateId])
  @@index([linkedCustomerId])
}

// Una fila por referencia pública al mismo local. sourceFingerprint permite
// upsert idempotente aun cuando distintos barridos vuelven a encontrarlo.
model ProspectSource {
  id                String @id @default(cuid())
  prospectId        String
  prospect          ProspectStore @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  provider          String // GOOGLE | GREEN_LIFE
  sourceFingerprint String @unique
  externalId        String?
  listingUrl        String?
  rawCategory       String?
  rawData           String @default("{}")
  scanId            String?
  scan              ProspectScan? @relation(fields: [scanId], references: [id], onDelete: SetNull)
  cellId            String?
  cell              ProspectScanCell? @relation(fields: [cellId], references: [id], onDelete: SetNull)
  firstSeenAt       DateTime @default(now())
  lastSeenAt        DateTime @default(now())

  @@index([prospectId])
  @@index([provider, externalId])
  @@index([scanId])
  @@index([cellId])
}

model ProspectStatusHistory {
  id         String @id @default(cuid())
  prospectId String
  prospect   ProspectStore @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  fromStatus String?
  toStatus   String
  reason     String?
  createdAt  DateTime @default(now())

  @@index([prospectId, createdAt])
}

// Solo se crea para similitudes no concluyentes. Nunca se fusiona automáticamente.
model ProspectDuplicateCandidate {
  id       String @id @default(cuid())
  firstId  String
  first    ProspectStore @relation("ProspectDuplicateFirst", fields: [firstId], references: [id], onDelete: Cascade)
  secondId String
  second   ProspectStore @relation("ProspectDuplicateSecond", fields: [secondId], references: [id], onDelete: Cascade)
  status   String @default("PENDING") // PENDING | MERGED | DISMISSED
  similarity Float
  reasons    String @default("[]")
  createdAt  DateTime @default(now())
  reviewedAt DateTime?

  @@unique([firstId, secondId])
  @@index([status, similarity])
  @@index([secondId])
}
